# Copy to .env to override the demo defaults. Never commit .env.
POSTGRES_PASSWORD=change-me-owner
RAGTR_APP_PASSWORD=change-me-app

# Deterministic, download-free demo (default) ...
RAGTR_EMBEDDER=hashing-384
RAGTR_GENERATOR=extractive
RAGTR_RERANKER=none
RAGTR_EXTRAS=

# ... or the real local stack: build the image with the ML extra, embed with multilingual E5,
# rerank with bge-reranker-v2-m3 and answer with a local LLM through Ollama (`--profile llm`).
# RAGTR_EXTRAS=ml
# RAGTR_EMBEDDER=e5-small
# RAGTR_RERANKER=bge-v2-m3
# RAGTR_GENERATOR=ollama
# RAGTR_OLLAMA_MODEL=gemma3:4b
